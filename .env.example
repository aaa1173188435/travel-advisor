# 复制为 .env（或直接设置环境变量）后生效；不配置任何 Key 也能完整使用规则引擎。

# --- 可选：真实天气（和风天气）---
# Key 在 https://console.qweather.com 的「项目管理」里创建（32 位）
TRAVEL_ADVISOR_WEATHER_KEY=
# 和风控制台「设置 → API Host」里的专属域名，例如 https://abc123.re.qweatherapi.com
# 公共的 devapi.qweather.com 已不可用（会返回 403 Invalid Host）
TRAVEL_ADVISOR_WEATHER_BASE_URL=
TRAVEL_ADVISOR_WEATHER_TIMEOUT=6

# --- 可选：大模型润色（任意 OpenAI 兼容接口）---
TRAVEL_ADVISOR_LLM_API_KEY=
TRAVEL_ADVISOR_LLM_BASE_URL=https://api.deepseek.com/v1
TRAVEL_ADVISOR_LLM_MODEL=deepseek-chat
TRAVEL_ADVISOR_LLM_TIMEOUT=12

# 也兼容直接读取 DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=

# --- 服务监听 ---
TRAVEL_ADVISOR_HOST=127.0.0.1
TRAVEL_ADVISOR_PORT=8010
